# Supabase — browser-safe configuration.
# These values are visible in the client bundle by design; they are not secrets.
# Data protection must come from Supabase Row Level Security (RLS) policies,
# not from hiding these values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Session — server-only secret used to seal the application session cookie.
# Never prefix this with VITE_, never commit a real value here, and never let
# the app fall back to a generated secret if it is unset. Minimum 32
# characters.
SESSION_SECRET=
